# ──────────────────────────────────────────────
# Lemon Squeezy Payments
# https://app.lemonsqueezy.com/settings/api
# ──────────────────────────────────────────────

# Your Lemon Squeezy API key (keep secret — server-side only)
LEMONSQUEEZY_API_KEY=live_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your store slug (the subdomain: https://SLUG.lemonsqueezy.com)
LEMONSQUEEZY_STORE_SLUG=yourstore

# Your numeric store ID (Settings → Store → Store ID)
LEMONSQUEEZY_STORE_ID=12345

# Which Lemon Squeezy environment this deployment accepts: "true" = test mode
# only, "false" = live only. Events/orders from the other mode are ignored.
# Use a separate deployment/env (with test-mode IDs below) for test checkouts.
LEMONSQUEEZY_TEST_MODE=false

# ── Core Game Pass ($19.99 one-time) — copy from Products → Core Game Pass.
# Leave empty until the product exists: purchase then shows "not available yet".
LEMONSQUEEZY_CORE_PRODUCT_ID=
LEMONSQUEEZY_CORE_VARIANT_ID=
# Hosted checkout link (https://<store>.lemonsqueezy.com/checkout/buy/<uuid>)
LEMONSQUEEZY_CORE_CHECKOUT_URL=

# ── Legacy purchases (honoured forever; never sold again) ──
# Full Access $49.99 (and older Standard/Expansion variants)
LEMONSQUEEZY_STANDARD_VARIANT_ID=111111
LEMONSQUEEZY_EXPANSION_VARIANT_ID=222222
# Starter $19.99 sold by the Next.js fork (chapters 1–5) — optional
LEMONSQUEEZY_LEGACY_STARTER_VARIANT_ID=

# ── Challenge Membership ($5.99/month, $39/year) — PREPARED, NOT LAUNCHED ──
# Stays disabled (pricing, checkout and prompts) until this is "true".
CHALLENGE_MEMBERSHIP_ENABLED=false
LEMONSQUEEZY_MEMBERSHIP_PRODUCT_ID=
LEMONSQUEEZY_MEMBERSHIP_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_MEMBERSHIP_ANNUAL_VARIANT_ID=
LEMONSQUEEZY_MEMBERSHIP_MONTHLY_CHECKOUT_URL=
LEMONSQUEEZY_MEMBERSHIP_ANNUAL_CHECKOUT_URL=

# Webhook signing secret (Settings → Webhooks → Secret)
# Point the webhook URL at: https://your-domain.com/api/ls-webhook
# Events: order_created, order_refunded, subscription_* (membership only)
LEMONSQUEEZY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Signs the access tokens the game stores after a verified purchase/restore.
# Long random string (e.g. `openssl rand -hex 32`); server-side only. Safe to
# rotate: put the old value in ENTITLEMENT_TOKEN_SECRET_PREVIOUS for a grace
# period (old tokens still verify and are re-issued on refresh), then remove it.
ENTITLEMENT_TOKEN_SECRET=
ENTITLEMENT_TOKEN_SECRET_PREVIOUS=

# Cloud saves: identity secret for the email → account lookup key (and code /
# rate-limit hashing). REQUIRED for cloud saves. Set once; NOT part of routine
# rotation. If it must change, list the old value(s) in
# CLOUD_SAVE_ID_SECRET_PREVIOUS (comma-separated) and keep them until every
# player has re-verified — otherwise accounts lose access to their saves.
# Sessions don't depend on any secret.
CLOUD_SAVE_ID_SECRET=
CLOUD_SAVE_ID_SECRET_PREVIOUS=

# Safe fallback: "false" switches every cloud-save endpoint off (503 "disabled").
# Device saves keep working; stored cloud data and sessions are untouched, and
# switching back on resumes syncing. Use this instead of rolling code back.
CLOUD_SAVES_ENABLED=

# Vercel KV (purchase ledger, checkout claims, restore codes, cloud saves).
# Required for purchases and cloud saves: without KV they respond "unavailable"
# (saving on the player's device always works).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Your deployed app URL (no trailing slash) — used for checkout redirect
APP_URL=https://your-domain.com

# ──────────────────────────────────────────────
# Client-side (Vite) — prefix with VITE_ to expose to browser
# ──────────────────────────────────────────────

# Set to "true" to show a test-mode banner in the paywall UI
VITE_LS_TEST_MODE=true

# ──────────────────────────────────────────────
# RevenueCat (native Android/iOS billing)
# https://app.revenuecat.com → Project → API Keys → Android
# ──────────────────────────────────────────────

# Android public SDK key (safe to expose — not a secret)
VITE_REVENUECAT_ANDROID_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ──────────────────────────────────────────────
# Email
# ──────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
